# Copy this file to an untracked location and adjust the repository path before
# installing the systemd user timer. Do not commit private runtime paths.

COLLATZ_REPO_DIR=/path/to/3xN1
COLLATZ_BUILD_DIR=build
COLLATZ_SOURCE_MAX_N=100000000
COLLATZ_GPU_MIN_FREE_MB=4096

# Optional. Leave disabled unless a reviewed neural command is ready.
COLLATZ_RUN_NEURAL=0
COLLATZ_NEURAL_COMMAND=
