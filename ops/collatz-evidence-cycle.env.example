# Copy this file to an untracked location and adjust the repository path before
# installing the systemd user timer. Do not commit private runtime paths.

COLLATZ_REPO_DIR=/path/to/3xN1
COLLATZ_BUILD_DIR=build
COLLATZ_SOURCE_MAX_N=100000000
COLLATZ_GPU_MIN_FREE_MB=4096
COLLATZ_GPU_ALLOW_SHARED=0

# Optional CPU crunch mode. This extends the binary feature dataset in batches.
# Leave disabled unless the private runtime is expected to keep scanning.
COLLATZ_RUN_CPU_CRUNCH=0
COLLATZ_CPU_CRUNCH_STEP=10000000
COLLATZ_CPU_CRUNCH_THREADS=8
COLLATZ_CPU_CRUNCH_CHUNK_SIZE=250000
# Optional override when the feature file is managed by a container runtime.
COLLATZ_CPU_CRUNCH_COMMAND=

# Optional. Leave disabled unless a reviewed neural command is ready.
COLLATZ_RUN_NEURAL=0
COLLATZ_NEURAL_COMMAND=
