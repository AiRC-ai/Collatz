FROM nvidia/cuda:12.4.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /work

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY . /work
RUN cmake -S /work -B /work/build -DCMAKE_BUILD_TYPE=Release -DCOLLATZ_ENABLE_CUDA=ON \
    && cmake --build /work/build --parallel

CMD ["/work/build/collatz_scan_cuda", "1", "1000000", "/work/data/generated/cuda_features.csv"]
